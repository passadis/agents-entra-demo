PORT=3000
IDENTITY_MODE=simulation
PLANNER_MODE=fixture
# Optional model planner on Azure; requires Cognitive Services OpenAI User on the model resource.
# PLANNER_MODE=azure-openai
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-tool-capable-deployment
# Local state file. Azure uses /home/data/aegean/state.json.
DATA_FILE=data/state.json
# Live mode requires all the following; never commit credentials.
# AZURE_TENANT_ID=
# BLUEPRINT_CLIENT_ID=
# BLUEPRINT_PRINCIPAL_ID=
# MANAGED_IDENTITY_CLIENT_ID=
# TOOL_CLIENT_ID=
# AGENT_EU_CLIENT_ID=
# AGENT_EU_PRINCIPAL_ID=
# AGENT_US_CLIENT_ID=
# AGENT_US_PRINCIPAL_ID=
# SPONSOR_OBJECT_ID=
# GOVERNANCE_ADMIN_IDS=comma-separated-workforce-user-object-ids
